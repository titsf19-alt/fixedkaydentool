{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "headers": [
    { "source": "/api/(.*)", "headers": [
      { "key": "Cache-Control", "value": "s-maxage=3600, stale-while-revalidate=86400" }
    ]}
  ]
}
